reformat
diff: git diff @SHA@
spawn: feat-code-reviewer
  row: 7d
  mode: review
  lenses: 7d
  model: sonnet
  effort: medium
  report: @TOP@/specs/x/reports/7-7d.md
  continue: fresh
  diff: git diff @SHA@
  diff file: @TOP@/specs/x/reports/review.diff
boundary:	7	@TOP@/specs/x/reports/7-7a.md	@TOP@/specs/x/reports/7-7b.md	@TOP@/specs/x/reports/7-7c.md	@TOP@/specs/x/reports/7-7d.md	sum=7-7a.md:@SUM@	sum=7-7b.md:@SUM@	sum=7-7c.md:@SUM@	snapshot=@SNAP@
