# Who does what, and when the run waits for you (small and medium features).
# Render with `mise run diagrams`; the SVG is docs/img/gates.svg.
shape: sequence_diagram

classes: {
  # always stops
  gate: {style: {stroke: "#d17a00"; stroke-width: 3; font-color: "#d17a00"; bold: true}}
  # stops only when something needs your call
  maybe: {style: {stroke: "#d17a00"; stroke-width: 2; stroke-dash: 4; font-color: "#d17a00"}}
  back: {style.stroke-dash: 3}
}

you: You {shape: person}
cc: Claude Code\n(coordinator)
step: step.sh\n(one call per boundary)
agents: Agents\n(one fresh per phase)

you -> cc: an idea, via /brief
cc -> agents: review the brief
cc -> you: confirm the brief {class: gate}
you -> cc: /feat on the brief, in a fresh context
cc -> step: setup
step -> cc: spawn: specify
cc -> agents: specify
agents -> step: its report
step -> cc: "[soft] or [hard], logged (via the agent)"
cc -> you: "answer its open questions, if [hard]" {class: maybe}
you -> cc: your answer
cc -> step: "the answer, logged as answer:"
step -> step: "before each phase: did main move?"
step -> cc: "if it did: spawn the move"
cc -> agents: move onto main
cc -> you: decide on a conflict that changes behaviour, if any {class: maybe}
cc -> agents: plan + design review
cc -> step: the reviewers' reports
step -> cc: "[soft] or [hard]: findings merged"
cc -> you: "check the spec, decide on findings that need you, if [hard]" {class: maybe}
cc -> agents: tasks + consistency check
agents -> step: its report
step -> cc: "[soft] or [hard]: tasks compared (via the agent)"
cc -> you: "fix serious gaps or a task mismatch, if [hard]" {class: maybe}
cc -> agents: implement, story by story
agents -> step: each story's report
step -> cc: "next story, then the reviewers (via the agent)"
cc -> agents: code review
cc -> step: the reviewers' reports
step -> cc: "[soft] or [hard]: findings merged"
cc -> you: "decide on findings that need you, if [hard]" {class: maybe}
cc -> step: "the answer, logged as answer:"
cc -> agents: apply fixes, ship
cc -> step: "the done: check"
step -> cc: "done: PR #N"
agents -> you: pull request, yours to merge {class: back}
you -> cc: /feat rebase, when the PR conflicts
cc -> agents: rebase, resolve, checks, push
agents -> you: PR on the current main {class: back}
